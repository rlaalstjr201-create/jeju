# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/jeju

# ── Kakao ───────────────────────────────────────────────────────────────────
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
