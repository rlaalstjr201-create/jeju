{
  "name": "@jeju/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/build-landing.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:busan": "vitest run --mode busan",
    "test:nation": "vitest run --mode nation",
    "test:mutation": "stryker run",
    "e2e": "npm run build && node tests/e2e/browser.e2e.mjs",
    "e2e:busan": "vite build --mode busan && tsx scripts/build-landing.mjs && node tests/e2e/browser.e2e.mjs",
    "e2e:nation": "vite build --mode nation && tsx scripts/build-landing.mjs && node tests/e2e/browser.e2e.mjs",
    "build:jeju": "vite build --mode jeju && tsx scripts/build-landing.mjs",
    "e2e:jeju": "npm run build:jeju && node tests/e2e/browser.e2e.mjs",
    "build:spots": "node scripts/build-spots.mjs",
    "landing:slugs": "tsx scripts/build-landing.mjs --write-slugs",
    "check:slop": "tsx scripts/check-slop.ts",
    "check:jeju": "tsx scripts/jeju-baseline.ts",
    "check:links": "tsx scripts/check-links.ts",
    "make:icons": "tsx scripts/make-icons.ts",
    "aggregate:events": "tsx events/aggregate.ts",
    "analytics:report": "node scripts/analytics-report.mjs",
    "analytics:health": "node scripts/analytics-health.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "seo:crawl": "node scripts/seo/crawl.mjs",
    "seo:verify": "node scripts/seo/verify.mjs",
    "seo:report": "node scripts/seo/report.mjs",
    "seo:keywords": "node scripts/seo/keywords.mjs",
    "seo:forecast": "node scripts/seo/forecast.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "~8.7.1",
    "@stryker-mutator/vitest-runner": "~8.7.1",
    "@types/node": "^20.19.41",
    "dotenv": "^16.4.5",
    "jsdom": "^24.1.3",
    "terser": "^5.48.0",
    "tsx": "^4.22.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
