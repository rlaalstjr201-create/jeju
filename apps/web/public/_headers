# Cloudflare Pages response headers (docs/deploy.md, ADR-0063). A path is matched without its query string.
# Two rules setting one header on a path are joined into one value: /* sets only what no other rule sets (never
# Cache-Control).

# Every response: never inside another site's frame; no camera, microphone or payment (geolocation stays).
# HSTS: once seen, this host is HTTPS-only for a year (the site and its subdomains are already HTTPS on Pages).
# CSP (hardening only, ADR 보안점검 2026-11-02): base-uri·object·frame-ancestors locked, http subresources upgraded.
# It does NOT restrict script/img/connect — the page runs on inline bootstrap scripts and GTM/GA/네이버 분석 inject
# more at runtime, so a script-src would need per-build hashes (not done here); this closes base-tag, plugin and
# clickjacking vectors without breaking anything.
/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Content-hashed build files: a new build is a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always requested as spots.json?v=<content hash> (main.ts, sw.js): new data is a new URL.
/spots.json
  Cache-Control: public, max-age=31536000, immutable
# Always requested as places.<lang>.json?v=<content hash> (main.ts, ADR-0093).
/i18n/*
  Cache-Control: public, max-age=31536000, immutable

# The page, the service worker, the manifest and the plain pages: asked again on every visit, so a deploy shows.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/privacy-*
  Cache-Control: no-cache

# Icons, the link preview image, robots.txt: a day.
/icons/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
