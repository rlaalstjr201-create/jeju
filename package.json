{
  "name": "jeju",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run src/infrastructure/persistence/repositories.integration.test.ts",
    "test:watch": "vitest",
    "embed:batch": "tsx src/scripts/embed-batch.ts",
    "seed:visitjeju": "tsx src/scripts/seed-pipeline.ts --visitjeju-only",
    "seed:naver-discover": "tsx src/scripts/seed-pipeline.ts",
    "seed:naver-dryrun": "tsx src/scripts/seed-pipeline.ts --queries-file=src/config/naver-queries-dryrun.json",
    "seed:naver-minidryrun": "tsx src/scripts/seed-pipeline.ts --queries-file=src/config/naver-queries-minidryrun.json",
    "seed:naver-20dryrun": "tsx src/scripts/seed-pipeline.ts --queries-file=src/config/naver-queries-20dryrun.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "export:curator-queue": "tsx src/scripts/export-curator-queue.ts",
    "compare:providers": "tsx src/scripts/compare-providers.ts",
    "seed:naver-tc-dryrun": "tsx src/scripts/seed-pipeline.ts --queries-file=src/config/naver-queries-minidryrun.json --provider=openrouter --tool-calling",
    "seed:naver-tc-fullrun": "tsx src/scripts/seed-pipeline.ts --queries-file=src/config/naver-queries.json --provider=openrouter --tool-calling",
    "compare:tc": "tsx src/scripts/compare-tc.ts",
    "seed:visitjeju-reference-top1000": "echo DEPRECATED: use seed-visitjeju-v2.ts && exit 1",
    "seed:visitjeju-recollect": "echo DEPRECATED: use seed-visitjeju-v2.ts && exit 1",
    "enrich:kakao": "tsx src/scripts/enrich-kakao.ts",
    "enrich:kakao:dryrun": "tsx src/scripts/enrich-kakao.ts --dry-run",
    "enrich:awards": "tsx src/scripts/enrich-awards.ts",
    "enrich:awards:dryrun": "tsx src/scripts/enrich-awards.ts --dry-run",
    "enrich:buzz": "tsx src/scripts/enrich-buzz.ts",
    "enrich:buzz:dryrun": "tsx src/scripts/enrich-buzz.ts --dry-run",
    "enrich:kakao-loose": "tsx src/scripts/enrich-kakao-loose.ts",
    "enrich:kakao-loose:dryrun": "tsx src/scripts/enrich-kakao-loose.ts --dry-run",
    "enrich:kakao-retry": "tsx src/scripts/enrich-kakao-retry.ts",
    "enrich:kakao-retry:dryrun": "tsx src/scripts/enrich-kakao-retry.ts --dry-run",
    "enrich:naver-local": "tsx src/scripts/enrich-naver-local.ts",
    "enrich:naver-local:dryrun": "tsx src/scripts/enrich-naver-local.ts --dry-run",
    "awards:parse-bluerribbon": "tsx src/scripts/parse-bluerribbon.ts",
    "awards:seed": "tsx src/scripts/seed-bluerribbon-awards.ts",
    "awards:seed:dryrun": "tsx src/scripts/seed-bluerribbon-awards.ts --dry-run",
    "awards:geocode": "tsx src/scripts/geocode-awards.ts",
    "awards:geocode:dryrun": "tsx src/scripts/geocode-awards.ts --dry-run",
    "awards:match": "tsx src/scripts/match-awards-to-spots.ts",
    "awards:match:dryrun": "tsx src/scripts/match-awards-to-spots.ts --dry-run",
    "enrich:trend": "tsx src/scripts/enrich-trend.ts",
    "enrich:trend:dryrun": "tsx src/scripts/enrich-trend.ts --dry-run --limit=10",
    "collect:snippets": "tsx src/scripts/collect-snippets.ts",
    "collect:snippets:dryrun": "tsx src/scripts/collect-snippets.ts --dry-run --limit=10",
    "generate:comments": "tsx src/scripts/generate-comments.ts",
    "generate:comments:dryrun": "tsx src/scripts/generate-comments.ts --dry-run --limit=10",
    "generate:comments:v2": "tsx src/scripts/generate-comments-v2.ts --no-hhem",
    "generate:comments:v2:dryrun": "tsx src/scripts/generate-comments-v2.ts --dry-run --no-hhem --limit=10",
    "generate:comments:v2:hhem": "tsx src/scripts/generate-comments-v2.ts",
    "generate:comments:v2:hhem:dryrun": "tsx src/scripts/generate-comments-v2.ts --dry-run --limit=10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@fastify/sensible": "^6.0.4",
    "axios": "^1.7.0",
    "fastify": "^5.8.5",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.10.0",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.0",
    "msw": "^2.3.0",
    "node-html-parser": "^7.1.0",
    "testcontainers": "^10.10.0",
    "tsx": "^4.22.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
